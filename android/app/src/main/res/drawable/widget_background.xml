<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card. Plain shape, no theme attrs: the launcher inflates this, so
     ?android:attr values would resolve against the launcher's theme. 16dp
     matches the app's radius.md; API 31+ launchers clip to the system radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="16dp" />
</shape>
