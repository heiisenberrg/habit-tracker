<?xml version="1.0" encoding="utf-8"?>
<!--
  LIGHT values of the app's dynamic theme tokens. Generated by hand from
  DYNAMIC_TOKENS in src/theme/theme.ts — the JS reaches them as
  PlatformColor('@color/<name>'), and __tests__/themeAndroid.test.ts fails
  if any pair here drifts from the TypeScript table. Android alpha goes
  first (#AARRGGBB); the TS side writes it last (#RRGGBBAA).
-->
<resources>
    <color name="surface">#FFFFFF</color>
    <color name="background">#F5F5F5</color>
    <color name="ink">#000000</color>
    <color name="ink60">#B3000000</color>
    <color name="ink40">#8C8C8C</color>
    <color name="ink20">#D9D9D9</color>
    <color name="ink10">#E6E6E6</color>
    <color name="blue10">#FDECEC</color>
    <color name="info10">#EDEDED</color>
</resources>
